# ==============================================================
# WireItt environment variables
# Copy to .env for local demo mode, or set these in
# Vercel → Project → Settings → Environment Variables
# ==============================================================

# ---- Cloud mode (Supabase) — REQUIRED on Vercel ----
# When all three are set the app runs in cloud mode (Postgres + Auth + RLS).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only secret — never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Scheduler ----
# Long random string protecting /api/cron/tick (Vercel Cron sends it as a
# Bearer token; external pingers like cron-job.org can use ?secret=...).
# Generate one with: openssl rand -hex 32
CRON_SECRET=

# ---- Optional ----
# Canonical origin, e.g. https://wireitt.vercel.app (used for webhook URLs)
NEXT_PUBLIC_APP_URL=
# Run-log retention in days (default 30)
RUN_LOG_RETENTION_DAYS=
# Allow HTTP action nodes to call private/internal IPs (default: blocked in production)
ENGINE_ALLOW_PRIVATE_HTTP=

# ---- Local demo mode only (NOT needed on Vercel) ----
DATABASE_URL=file:./db/custom.db
# Secret used to sign local demo sessions
APP_SECRET=
